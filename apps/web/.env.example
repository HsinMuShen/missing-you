# Local development — copy to `.env.local` (never commit secrets).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/missing_you"

# Default journaling user when API requests omit userId (until auth exists)
# DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# Stored on MemoryAnchor rows from confirm-anchor (no chain call in this MVP step)
# ANCHOR_CHAIN=sepolia

# Optional: used when wiring on-chain anchoring from the BFF
# SEPOLIA_RPC_URL=
# ANCHOR_PRIVATE_KEY=
# MEMORY_REGISTRY_ADDRESS=
