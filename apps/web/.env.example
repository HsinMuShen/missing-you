# Local development — copy to `.env.local` (never commit secrets).

# Core app URL (used for metadata URLs and share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/missing_you"

# Auth.js (email magic-link)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
# SMTP string, e.g. smtp://user:pass@localhost:1025
# If empty in development, links are logged to the server console.
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM="Missing You <no-reply@missing-you.local>"
# Optional monitoring sink (placeholder integration)
# SENTRY_DSN=https://<public-key>@o0.ingest.sentry.io/<project-id>

# --- Anchoring (Polygon-compatible) ---
# Generic aliases (supported):
# NEXT_PUBLIC_CHAIN_ID=80002
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
# RPC_URL=https://...
# NEXT_PUBLIC_EXPLORER_BASE_URL=https://amoy.polygonscan.com
#
# Default chain for UI + validation: 80002 (Amoy) or 137 (Polygon mainnet)
NEXT_PUBLIC_ANCHOR_CHAIN_ID=80002

# Deployed MemoryRegistry (required for wallet anchor + server validation)
NEXT_PUBLIC_MEMORY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Server-side JSON-RPC for receipt checks + getMemory reads (never commit secrets)
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-key
POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-key

# Optional public RPC endpoints for browser wallet reads/transports
# NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-key
# NEXT_PUBLIC_POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-key

# Optional explorer overrides (defaults to Polygonscan hosts)
NEXT_PUBLIC_POLYGON_AMOY_EXPLORER_BASE_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_POLYGON_MAINNET_EXPLORER_BASE_URL=https://polygonscan.com

# Optional: WalletConnect v2 (MetaMask / others still work via injected)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
