// Prisma — PostgreSQL. Journal text is off-chain only; MemoryAnchor mirrors on-chain proof metadata.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  walletAddress  String?   @unique
  defaultPrivacy String    @default("private")
  createdAt      DateTime  @default(now())

  journals Journal[]
  accounts Account[]
  sessions Session[]
  walletLinkChallenge WalletLinkChallenge?
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String?
  content  String
  person   String?
  privacy  String
  status   String   @default("draft")
  memoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anchor MemoryAnchor?

  @@index([userId, createdAt])
}

model MemoryAnchor {
  id              String   @id @default(uuid())
  journalId       String   @unique
  journal         Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  memoryId        String
  contentHash     String
  txHash          String?
  chain           String
  chainId         Int?
  contractAddress String?
  anchoredAt      DateTime?
  createdAt       DateTime @default(now())
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model WalletLinkChallenge {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String
  nonce      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, address])
}
