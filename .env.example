# Copy these values into apps/web/.env.local for local development.
# The web app is the runtime for Prisma, Auth, and blockchain BFF checks.

NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missing_you

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM="Missing You <no-reply@missing-you.local>"
SENTRY_DSN=

NEXT_PUBLIC_ANCHOR_CHAIN_ID=80002
NEXT_PUBLIC_MEMORY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ETHEREUM_MAINNET_RPC_URL=
POLYGON_AMOY_RPC_URL=
POLYGON_MAINNET_RPC_URL=
NEXT_PUBLIC_ETHEREUM_MAINNET_RPC_URL=
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=
NEXT_PUBLIC_POLYGON_MAINNET_RPC_URL=

# Optional generic aliases for infra tools:
# NEXT_PUBLIC_CHAIN_ID=80002
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-key
# NEXT_PUBLIC_EXPLORER_BASE_URL=https://amoy.polygonscan.com

NEXT_PUBLIC_POLYGON_AMOY_EXPLORER_BASE_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_POLYGON_MAINNET_EXPLORER_BASE_URL=https://polygonscan.com

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
